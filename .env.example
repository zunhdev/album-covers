# Credentials for `covers`. Copy this file to
#   ~/.config/album-covers/credentials.env     (macOS and Linux)
#   %APPDATA%\album-covers\credentials.env     (Windows)
# or to .env in the directory you run `covers` from, then fill in the services you use.

# TIDAL: https://developer.tidal.com/dashboard  (create an app, copy its Client ID and Client Secret)
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Spotify: https://developer.spotify.com/dashboard  (create an app, copy its Client ID and Client Secret)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
